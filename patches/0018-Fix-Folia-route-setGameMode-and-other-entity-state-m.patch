@@ -41,6 +41,7 @@ public class Commandheal extends EssentialsLoopCommand {
 
     @Override
     protected void updatePlayer(final Server server, final CommandSource sender, final User user, final String[] args) throws PlayerExemptException {
+        ess.getEntityScheduler(user.getBase()).run(ess, scheduledTask -> {
         try {
             final Player player = user.getBase();
 
@@ -75,7 +76,10 @@ public class Commandheal extends EssentialsLoopCommand {
             }
         } catch (final QuietAbortException e) {
             //Handle Quietly
+        } catch (final PlayerExemptException e) {
+            // Thrown inside the scheduled task on the entity's region thread; cannot propagate to the command sender.
         }
+        }, null);
     }
 
     @Override
