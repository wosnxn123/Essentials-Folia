From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ZCode Agent <agent@zcode.local>
Date: Fri, 3 Jul 2026 01:24:14 +0800
Subject: [PATCH] Fix Folia: route setGameMode and other entity state mutations
 through EntityScheduler

Cross-player commands (gamemode, heal, feed, ext) mutated the target
player's entity state directly from the command thread, which crashes
on Folia/Canvas with 'Cannot set gamemode async' / similar entity
scheduling errors. Wrap the entity operations in the target player's
EntityScheduler, matching the existing pattern used by Commandkill
and Commandlightning.

diff --git a/Essentials/src/main/java/com/earth2me/essentials/commands/Commandext.java b/Essentials/src/main/java/com/earth2me/essentials/commands/Commandext.java
index 0b9601f94b39a20fd41223b1164960ec66c32d31..d0464d91a1696600ad1ad95990fee6b2b2182304 100644
--- a/Essentials/src/main/java/com/earth2me/essentials/commands/Commandext.java
+++ b/Essentials/src/main/java/com/earth2me/essentials/commands/Commandext.java
@@ -35,8 +35,10 @@ public class Commandext extends EssentialsLoopCommand {
 
     @Override
     protected void updatePlayer(final Server server, final CommandSource sender, final User player, final String[] args) {
-        extPlayer(player.getBase());
-        sender.sendTl("extinguishOthers", player.getDisplayName());
+        ess.getEntityScheduler(player.getBase()).run(ess, scheduledTask -> {
+            extPlayer(player.getBase());
+            sender.sendTl("extinguishOthers", player.getDisplayName());
+        }, null);
     }
 
     private void extPlayer(final Player player) {
diff --git a/Essentials/src/main/java/com/earth2me/essentials/commands/Commandfeed.java b/Essentials/src/main/java/com/earth2me/essentials/commands/Commandfeed.java
index fcf97889cc97d29c53cec4a2e8e6cf3c119c91f4..a7ebf8775c406a019cc62841f110c8a70eee6f35 100644
--- a/Essentials/src/main/java/com/earth2me/essentials/commands/Commandfeed.java
+++ b/Essentials/src/main/java/com/earth2me/essentials/commands/Commandfeed.java
@@ -40,12 +40,14 @@ public class Commandfeed extends EssentialsLoopCommand {
 
     @Override
     protected void updatePlayer(final Server server, final CommandSource sender, final User player, final String[] args) throws PlayerExemptException {
+        ess.getEntityScheduler(player.getBase()).run(ess, scheduledTask -> {
         try {
             feedPlayer(player.getBase());
             sender.sendTl("feedOther", player.getDisplayName());
         } catch (final QuietAbortException e) {
             //Handle Quietly
         }
+        }, null);
     }
 
     private void feedPlayer(final Player player) throws QuietAbortException {
diff --git a/Essentials/src/main/java/com/earth2me/essentials/commands/Commandgamemode.java b/Essentials/src/main/java/com/earth2me/essentials/commands/Commandgamemode.java
index bb9860c80c59bf475720d4c9d2c6b94d1b3651aa..10f92bc5dc3682d5a322b40a19ba64add57cf5a3 100644
--- a/Essentials/src/main/java/com/earth2me/essentials/commands/Commandgamemode.java
+++ b/Essentials/src/main/java/com/earth2me/essentials/commands/Commandgamemode.java
@@ -59,8 +59,11 @@ public class Commandgamemode extends EssentialsLoopCommand {
             return;
         }
 
-        user.getBase().setGameMode(gameMode);
-        user.sendTl("gameMode", user.playerTl(user.getBase().getGameMode().toString().toLowerCase(Locale.ENGLISH)), user.getDisplayName());
+        final GameMode finalGameMode = gameMode;
+        ess.getEntityScheduler(user.getBase()).run(ess, scheduledTask -> {
+            user.getBase().setGameMode(finalGameMode);
+            user.sendTl("gameMode", user.playerTl(user.getBase().getGameMode().toString().toLowerCase(Locale.ENGLISH)), user.getDisplayName());
+        }, null);
     }
 
     private void setUserGamemode(final CommandSource sender, final GameMode gameMode, final User user) throws NotEnoughArgumentsException {
@@ -73,8 +76,10 @@ public class Commandgamemode extends EssentialsLoopCommand {
             return;
         }
 
-        user.getBase().setGameMode(gameMode);
-        sender.sendTl("gameMode", sender.tl(gameMode.toString().toLowerCase(Locale.ENGLISH)), user.getDisplayName());
+        ess.getEntityScheduler(user.getBase()).run(ess, scheduledTask -> {
+            user.getBase().setGameMode(gameMode);
+            sender.sendTl("gameMode", sender.tl(gameMode.toString().toLowerCase(Locale.ENGLISH)), user.getDisplayName());
+        }, null);
     }
 
     // essentials.gamemode will let them change to any but essentials.gamemode.survival would only let them change to survival.
diff --git a/Essentials/src/main/java/com/earth2me/essentials/commands/Commandheal.java b/Essentials/src/main/java/com/earth2me/essentials/commands/Commandheal.java
index 7f72526660ef2a931a3110a7e278861ec8de573f..61ad25c867351beb6aeedf49ff0f46175e11c6bb 100644
--- a/Essentials/src/main/java/com/earth2me/essentials/commands/Commandheal.java
